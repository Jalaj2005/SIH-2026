# Copy this file to .env and fill in real values.
# Never commit the actual .env file to git.

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- AlienVault OTX (get a free key at https://otx.alienvault.com) ---
OTX_API_KEY=your_otx_api_key_here
OTX_TAXII_URL=https://otx.alienvault.com/taxii/discovery
OTX_COLLECTION_ID=

# --- URLhaus fallback feed (no key required) ---
URLHAUS_CSV_URL=https://urlhaus.abuse.ch/downloads/csv_recent/

# --- Sync scheduler ---
SYNC_INTERVAL_MINUTES=30

# --- FastAPI server ---
APP_HOST=0.0.0.0
APP_PORT=8003
